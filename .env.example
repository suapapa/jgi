# OpenAI 호환 API 설정
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 웹 서버 (jgi-serve)
REPORTS_DIR=reports
CACHE_DIR=cache
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USERNAME=
WEB_PASSWORD=
SCHEDULE_CRON=0 7 * * *
REPORT_TOP=30

# 매일 리포트를 생성할 갤러리 (쉼표 구분, 비우면 전체)
#   krstock   = DC인사이드 한국주식 갤러리
#   tenbagger = DC인사이드 해외주식 갤러리
GALLERIES=krstock,tenbagger
